#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

// retro delta: count the active tokens for the fused sparse cross-entropy.
// A token is active when its target is a real vocab id and its GRPO weight is
// non-zero. The result (n_active) is the divisor both the forward loss and the
// backward gradient use, computed on device so the semantics match the CPU
// reference exactly (see docs/memory/GPUVOCAB.md). One thread per token.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint n_embd;
    uint n_tokens;
    uint n_vocab;
    uint h_stride;
    uint d_stride;
} p;

layout(binding = 0) readonly  buffer Tgt   {int   data_tgt[];};
layout(binding = 1) readonly  buffer Wgt   {float data_wgt[];};
layout(binding = 2) coherent  buffer Count {uint  data_count[];};

void main() {
    const uint t = gl_GlobalInvocationID.x;
    if (t >= p.n_tokens) {
        return;
    }
    const int tgt = data_tgt[t];
    const float wgt = data_wgt[t];
    if (tgt >= 0 && uint(tgt) < p.n_vocab && wgt != 0.0f) {
        atomicAdd(data_count[0], 1u);
    }
}
