#version 450

#extension GL_EXT_control_flow_attributes : enable
#ifdef SSM_SCAN_BACK_GRAD
#extension GL_EXT_shader_atomic_float : require
#endif

// Two-pass backward of the Mamba-2 selective scan. The checkpoint pass
// replays each (head, sequence) chain once and stores the state at chunk
// boundaries. Gradient dispatches then walk chunks from last to first,
// recomputing only the current chunk and carrying the reverse adjoint between
// dispatches. This reduces the former per-element O(T^2) replay to O(T).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint d_state, head_dim, n_head, n_group, n_seq_tokens, n_seqs, n_A0;
    uint off_dt, off_A, off_B, off_C, off_s;
    uint nb00, nb01, nb02, nb03;
    uint nb10, nb11, nb12, nb13;
    uint nb20, nb21, nb22;
    uint nb30, nb31;
    uint nb40, nb41, nb42, nb43;
    uint nb50, nb51, nb52, nb53;
    uint nb60;
    uint tc, chunk_lo, chunk_hi;
} p;

float softplus(float v) { return v <= 20.0f ? log(1.0f + exp(v)) : v; }

#ifdef SSM_SCAN_BACK_CKPT

layout(binding = 0) readonly buffer S   { float data_s[]; };
layout(binding = 1) readonly buffer X   { float data_x[]; };
layout(binding = 2) readonly buffer Dt  { float data_dt[]; };
layout(binding = 3) readonly buffer Av  { float data_A[]; };
layout(binding = 4) readonly buffer Bv  { float data_B[]; };
layout(binding = 5) readonly buffer Ids { int   data_ids[]; };
layout(binding = 6) readonly buffer Ds  { float data_ds[]; };
layout(binding = 7)          buffer K   { float data_ckpt[]; };
layout(binding = 8)          buffer Lc  { float data_carry[]; };

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint s = gl_WorkGroupID.y;
    if (h >= p.n_head || s >= p.n_seqs) {
        return;
    }

    const uint tid = gl_LocalInvocationIndex;
    const uint cs = p.d_state * p.head_dim;
    const uint chains = p.n_head * p.n_seqs;
    const uint ch = s * p.n_head + h;
    const uint g = h / (p.n_head / p.n_group);
    const int slot = data_ids[s * p.nb60];

    for (uint pair = tid; pair < cs; pair += gl_WorkGroupSize.x) {
        const uint pp = pair / p.d_state;
        const uint n = pair % p.d_state;
        const float A = data_A[(p.n_A0 == 1u ? 0u : n * p.nb30) + h * p.nb31];

        data_carry[ch * cs + pair] = data_ds[p.off_dt + s * p.n_head * cs + h * cs + pair];

        float state = data_s[n * p.nb00 + pp * p.nb01 + h * p.nb02 + uint(slot) * p.nb03];
        for (uint t = 0u; t < p.n_seq_tokens; ++t) {
            if (t % p.tc == 0u) {
                data_ckpt[((t / p.tc) * chains + ch) * cs + pair] = state;
            }
            const float dtv = data_dt[h * p.nb20 + t * p.nb21 + s * p.nb22];
            const float dsp = softplus(dtv);
            const float xv = data_x[pp * p.nb10 + h * p.nb11 + t * p.nb12 + s * p.nb13];
            const float B = data_B[n * p.nb40 + g * p.nb41 + t * p.nb42 + s * p.nb43];
            state = state * exp(dsp * A) + B * xv * dsp;
        }
    }
}

#else

layout(binding = 0)  readonly buffer X    { float data_x[]; };
layout(binding = 1)  readonly buffer Dt   { float data_dt[]; };
layout(binding = 2)  readonly buffer Av   { float data_A[]; };
layout(binding = 3)  readonly buffer Bv   { float data_B[]; };
layout(binding = 4)  readonly buffer Cv   { float data_C[]; };
layout(binding = 5)  readonly buffer Ids  { int   data_ids[]; };
layout(binding = 6)  readonly buffer Ds   { float data_ds[]; };
layout(binding = 7)           buffer D    { float data_d[]; };
layout(binding = 8)           buffer Tr   { float data_traj[]; };
layout(binding = 9)           buffer La   { float data_lam[]; };
layout(binding = 10) readonly buffer K    { float data_ckpt[]; };
layout(binding = 11)          buffer Lc   { float data_carry[]; };

shared float red[256];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint s = gl_WorkGroupID.y;
    if (h >= p.n_head || s >= p.n_seqs) {
        return;
    }

    const uint tid = gl_LocalInvocationIndex;
    const uint cs = p.d_state * p.head_dim;
    const uint chains = p.n_head * p.n_seqs;
    const uint ch = s * p.n_head + h;
    const uint g = h / (p.n_head / p.n_group);
    const uint ich = p.chunk_lo / p.tc;
    const int slot = data_ids[s * p.nb60];

    // Recompute the states in this chunk from its forward checkpoint.
    for (uint pair = tid; pair < cs; pair += gl_WorkGroupSize.x) {
        const uint pp = pair / p.d_state;
        const uint n = pair % p.d_state;
        const float A = data_A[(p.n_A0 == 1u ? 0u : n * p.nb30) + h * p.nb31];
        float state = data_ckpt[(ich * chains + ch) * cs + pair];
        for (uint t = p.chunk_lo; t < p.chunk_hi; ++t) {
            const float dtv = data_dt[h * p.nb20 + t * p.nb21 + s * p.nb22];
            const float dsp = softplus(dtv);
            const float xv = data_x[pp * p.nb10 + h * p.nb11 + t * p.nb12 + s * p.nb13];
            const float B = data_B[n * p.nb40 + g * p.nb41 + t * p.nb42 + s * p.nb43];
            state = state * exp(dsp * A) + B * xv * dsp;
            data_traj[((t - p.chunk_lo) * chains + ch) * cs + pair] = state;
        }
    }
    memoryBarrierBuffer();
    barrier();

    // Reverse adjoint in the chunk and carry it to the preceding dispatch.
    for (uint pair = tid; pair < cs; pair += gl_WorkGroupSize.x) {
        const uint pp = pair / p.d_state;
        const uint n = pair % p.d_state;
        const float A = data_A[(p.n_A0 == 1u ? 0u : n * p.nb30) + h * p.nb31];
        float future = data_carry[ch * cs + pair];
        float acc_A = 0.0f;
        for (int ti = int(p.chunk_hi) - 1; ti >= int(p.chunk_lo); --ti) {
            const uint t = uint(ti);
            const float dtv = data_dt[h * p.nb20 + t * p.nb21 + s * p.nb22];
            const float dsp = softplus(dtv);
            const float aval = exp(dsp * A);
            const float dy = data_ds[pp + h * p.head_dim + t * p.head_dim * p.n_head +
                                     s * p.n_seq_tokens * p.head_dim * p.n_head];
            const float C = data_C[n * p.nb50 + g * p.nb51 + t * p.nb52 + s * p.nb53];
            const float lambda = dy * C + future;
            data_lam[((t - p.chunk_lo) * chains + ch) * cs + pair] = lambda;
            const float prev = t == p.chunk_lo
                    ? data_ckpt[(ich * chains + ch) * cs + pair]
                    : data_traj[((t - 1u - p.chunk_lo) * chains + ch) * cs + pair];
            acc_A += lambda * prev * dsp * aval;
            future = aval * lambda;
            if (t == 0u) {
                const uint is0 = p.off_s + n + pp * p.d_state + h * cs + uint(slot) * cs * p.n_head;
                atomicAdd(data_d[is0], future);
            }
        }
        data_carry[ch * cs + pair] = future;
        const uint iA = p.off_A + (p.n_A0 == 1u ? h : n + h * p.d_state);
        atomicAdd(data_d[iA], acc_A);
    }
    memoryBarrierBuffer();
    barrier();

    // Exclusive grad_x/grad_dt cells are assigned directly. B and C are
    // shared by heads in a group and receive one atomic contribution per head.
    for (uint t = p.chunk_lo; t < p.chunk_hi; ++t) {
        const uint toff = ((t - p.chunk_lo) * chains + ch) * cs;
        const float dtv = data_dt[h * p.nb20 + t * p.nb21 + s * p.nb22];
        const float dsp = softplus(dtv);
        const float sig = dtv > 20.0f ? 1.0f : 1.0f / (1.0f + exp(-dtv));

        float part = 0.0f;
        for (uint pair = tid; pair < cs; pair += gl_WorkGroupSize.x) {
            const uint pp = pair / p.d_state;
            const uint n = pair % p.d_state;
            const float A = data_A[(p.n_A0 == 1u ? 0u : n * p.nb30) + h * p.nb31];
            const float aval = exp(dsp * A);
            const float xv = data_x[pp * p.nb10 + h * p.nb11 + t * p.nb12 + s * p.nb13];
            const float B = data_B[n * p.nb40 + g * p.nb41 + t * p.nb42 + s * p.nb43];
            const float lambda = data_lam[toff + pair];
            const float prev = t == p.chunk_lo
                    ? data_ckpt[(ich * chains + ch) * cs + pair]
                    : data_traj[toff - chains * cs + pair];
            part += lambda * prev * A * aval + xv * lambda * B;
        }
        red[tid] = part;
        barrier();
        if (tid == 0u) {
            float acc = 0.0f;
            for (uint i = 0u; i < gl_WorkGroupSize.x; ++i) {
                acc += red[i];
            }
            data_d[p.off_dt + h + t * p.n_head + s * p.n_head * p.n_seq_tokens] = acc * sig;
        }
        barrier();

        for (uint i = tid; i < p.head_dim + 2u * p.d_state; i += gl_WorkGroupSize.x) {
            if (i < p.head_dim) {
                const uint pp = i;
                float acc = 0.0f;
                for (uint n = 0u; n < p.d_state; ++n) {
                    const float B = data_B[n * p.nb40 + g * p.nb41 + t * p.nb42 + s * p.nb43];
                    acc += data_lam[toff + pp * p.d_state + n] * B;
                }
                data_d[pp + h * p.head_dim + t * p.head_dim * p.n_head +
                       s * p.n_seq_tokens * p.head_dim * p.n_head] = dsp * acc;
            } else if (i < p.head_dim + p.d_state) {
                const uint n = i - p.head_dim;
                float acc = 0.0f;
                for (uint pp = 0u; pp < p.head_dim; ++pp) {
                    const float xv = data_x[pp * p.nb10 + h * p.nb11 + t * p.nb12 + s * p.nb13];
                    acc += data_lam[toff + pp * p.d_state + n] * xv;
                }
                const uint iB = p.off_B + n + g * p.d_state + t * p.d_state * p.n_group +
                                s * p.d_state * p.n_group * p.n_seq_tokens;
                atomicAdd(data_d[iB], acc * dsp);
            } else {
                const uint n = i - p.head_dim - p.d_state;
                float acc = 0.0f;
                for (uint pp = 0u; pp < p.head_dim; ++pp) {
                    const float dy = data_ds[pp + h * p.head_dim + t * p.head_dim * p.n_head +
                                             s * p.n_seq_tokens * p.head_dim * p.n_head];
                    acc += dy * data_traj[toff + pp * p.d_state + n];
                }
                const uint iC = p.off_C + n + g * p.d_state + t * p.d_state * p.n_group +
                                s * p.d_state * p.n_group * p.n_seq_tokens;
                atomicAdd(data_d[iC], acc);
            }
        }
        barrier();
    }
}

#endif
